# HTTP server
ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s

# Upstream FX provider (Frankfurter, ECB rates). Frankfurter migrated to
# this domain; the old api.frankfurter.app now 301-redirects here. Go's
# http.Client follows redirects by default so the old URL "worked," but
# it cost an extra DNS+TLS+request round trip on every single vendor
# call. Pointing at the canonical URL directly avoids that silent tax.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
UPSTREAM_TIMEOUT=4s
# Retry: per-call attempts, with full-jitter exponential backoff between
# them (an explicit vendor Retry-After header is honored over backoff).
# Overall call budget is derived as MaxAttempts * (UPSTREAM_TIMEOUT +
# RETRY_MAX_DELAY), not independently configurable, so it can never be
# set lower than what the attempts themselves need.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=100ms
RETRY_MAX_DELAY=2s

# Circuit breaker: trips once at least BREAKER_FAILURE_THRESHOLD calls
# have been made AND at least half of them failed. Stays open for
# BREAKER_OPEN_DURATION, then allows a few trial requests through
# (half-open) before fully closing again.
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_DURATION=30s

# Bulkhead + vendor HTTP transport tuning. The concurrency cap bounds how
# many simultaneous calls to Frankfurter we allow regardless of inbound
# request volume, so a slow vendor can't exhaust our goroutines/connections.
VENDOR_MAX_CONCURRENT_CALLS=20
VENDOR_MAX_IDLE_CONNS=50
VENDOR_MAX_IDLE_CONNS_PER_HOST=10
VENDOR_IDLE_CONN_TIMEOUT=90s
# Caps how much of a single vendor response body we'll read, so a huge or
# malformed response can't exhaust our memory.
VENDOR_MAX_RESPONSE_BYTES=1048576

# Rates cache. Frankfurter (ECB data) publishes one new rate per TARGET
# business day and nothing changes over weekends/holidays, so these
# defaults are chosen against that cadence, not typical "web API"
# freshness:
#   - CACHE_FRESH_TTL=1h: no benefit to polling faster since the rate
#     won't have moved, but short enough that an intra-day vendor
#     correction or a restart isn't pinned to very old "fresh" data.
#   - CACHE_STALE_MAX_AGE=48h: covers a normal weekend (serving Friday's
#     close through Sat/Sun is correct, not degraded) plus one full extra
#     business day of vendor-outage buffer. Beyond this we refuse to
#     serve the rate at all (503) rather than silently show a 2-day-old
#     FX rate on a payment screen.
CACHE_FRESH_TTL=1h
CACHE_STALE_MAX_AGE=48h
# How long we remember "the vendor said this currency doesn't exist"
# before trying again — short and independent of the rate TTLs above, so
# spamming an invalid currency code doesn't cost a vendor call every time,
# but a currency Frankfurter adds support for later isn't blocked long.
CACHE_NEGATIVE_TTL=60s
# Max distinct base+symbols cache entries (LRU eviction beyond this).
CACHE_MAX_ENTRIES=2000

# Inbound rate limiting (per client IP, token bucket). /health, /ready,
# and /metrics are never rate limited.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Postgres connection pool (pgx/v5 + pgxpool), used for the async audit
# log below. Credentials have a working local default matching the
# docker-compose postgres service, but nothing is hardcoded in Go code —
# every value here is read from env, this is just its default.
POSTGRES_DSN=postgres://fx:fx@localhost:5432/fx?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m
POSTGRES_CONNECT_TIMEOUT=5s

# Audit log: every request is recorded async, off the hot path (see
# internal/audit). Enqueue never blocks the API; if the in-memory queue
# fills up (AUDIT_QUEUE_SIZE), new records are DROPPED and counted in
# fxservice_audit_records_dropped_total rather than slowing down or
# failing the request. A real regulated fintech audit trail generally
# cannot accept dropped records — see the README for what a production
# system would do instead (transactional outbox / Kafka).
AUDIT_QUEUE_SIZE=10000
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL=2s
AUDIT_RETRY_BASE_DELAY=200ms
AUDIT_RETRY_MAX_DELAY=10s
# How long graceful shutdown waits to drain whatever's still queued
# before giving up and dropping the rest.
AUDIT_SHUTDOWN_FLUSH_TIMEOUT=5s

# Observability
LOG_LEVEL=info
SERVICE_NAME=sezzle-fx-service
# Prometheus metrics are always exported at /metrics (no on/off switch,
# no auth) — same as /health and /ready, this is infrastructure traffic,
# not something we gate behind config. No env vars to tune here; see
# internal/metrics and the README for what's exported.
